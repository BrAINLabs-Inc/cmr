NODE_ENV=development
PORT=4000
LOG_LEVEL=info
SUPABASE_URL=https://ovncyabynsssugruoybd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Comma-separated list of origins allowed to call this API. Required (no
# wildcard fallback) when NODE_ENV=production.
CORS_ORIGIN=http://localhost:5173
# General API rate limit (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
# Temporary: set to true to skip Supabase storage uploads/downloads for
# application documents (while the storage bucket isn't set up yet).
SKIP_STORAGE_UPLOAD=false
